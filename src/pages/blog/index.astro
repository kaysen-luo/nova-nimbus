---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`所有随笔 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="wrap">
			<Header />
			<main>
				<h2 class="page-title">全部</h2>

				<div class="stack" style="display:flex;flex-direction:column;gap:32px;">
					{
						posts.map((post) => (
							<article class="post">
								<div class="meta">
									<span class="tag">{post.data.category}</span>
									<FormattedDate class="date" date={post.data.pubDate} />
								</div>
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="excerpt">{post.data.description}</p>
							</article>
						))
					}
					{
						posts.length === 0 && (
							<p style="color:var(--muted);font-style:italic;">
								这个分类下还没有随笔 ✍️
							</p>
						)
					}
				</div>
			</main>
		</div>
		<Footer />
	</body>
</html>
