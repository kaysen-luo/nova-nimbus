---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: 0 var(--space-5);
			}

			/* ============ HERO ============ */
			.hero {
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: var(--space-7);
				padding: var(--space-10) 0 var(--space-8);
			}
			.hero-text {
				display: flex;
				flex-direction: column;
				gap: var(--space-3);
			}
			.hero-name {
				font-size: var(--fs-3xl);
				font-weight: var(--fw-bold);
				line-height: var(--lh-tight);
				margin: 0;
				background: var(--brand-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				letter-spacing: -0.01em;
			}
			.hero-headline {
				font-size: var(--fs-xl);
				font-weight: var(--fw-semi);
				color: var(--text-primary);
				margin: 0;
				line-height: var(--lh-tight);
			}
			.hero-tagline {
				font-size: var(--fs-lg);
				color: var(--text-secondary);
				margin: var(--space-1) 0 0;
				font-weight: var(--fw-medium);
				line-height: var(--lh-normal);
			}
			.hero-actions {
				display: flex;
				gap: var(--space-3);
				margin-top: var(--space-5);
				flex-wrap: wrap;
			}
			.btn {
				display: inline-block;
				padding: var(--space-3) var(--space-6);
				border-radius: var(--radius-pill);
				font-weight: var(--fw-semi);
				text-decoration: none;
				transition: all var(--transition-base);
				font-size: var(--fs-base);
				border: 2px solid transparent;
				line-height: var(--lh-tight);
			}
			.btn-brand {
				background: var(--brand-gradient);
				color: #fff;
			}
			.btn-brand:hover {
				transform: translateY(-2px);
				box-shadow: var(--shadow-lg);
				color: #fff;
			}
			.btn-alt {
				background: var(--bg-elevated);
				color: var(--brand-primary);
				border-color: var(--brand-primary);
			}
			.btn-alt:hover {
				background: var(--brand-soft);
				transform: translateY(-2px);
				color: var(--brand-primary);
			}
			.hero-avatar {
				width: 220px;
				height: 220px;
				border-radius: 50%;
				object-fit: cover;
				box-shadow: var(--shadow-xl);
				border: 5px solid var(--bg-elevated);
			}

			/* ============ FEATURES ============ */
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--space-4);
				padding: var(--space-4) 0 var(--space-10);
			}
			.feature {
				display: block;
				background: var(--bg-elevated);
				border-radius: var(--radius-lg);
				padding: var(--space-5);
				text-decoration: none;
				color: inherit;
				transition: all var(--transition-base);
				border: 1px solid var(--border-subtle);
				border-top: 4px solid var(--brand-primary);
			}
			.feature:nth-child(2) {
				border-top-color: var(--brand-rose);
			}
			.feature:nth-child(3) {
				border-top-color: var(--accent-gold);
			}
			.feature:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-lg);
				border-color: var(--brand-soft);
				color: inherit;
			}
			.feature h3 {
				margin: 0 0 var(--space-2);
				font-size: var(--fs-md);
				color: var(--brand-primary);
				font-weight: var(--fw-semi);
			}
			.feature:nth-child(2) h3 { color: var(--brand-rose); }
			.feature:nth-child(3) h3 { color: var(--accent-gold); }
			.feature p {
				margin: 0;
				color: var(--text-secondary);
				font-size: var(--fs-sm);
				line-height: var(--lh-loose);
			}

			/* ============ MOBILE ============ */
			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					text-align: center;
					gap: var(--space-5);
					padding: var(--space-6) 0;
				}
				.hero-avatar {
					width: 160px;
					height: 160px;
					margin: 0 auto;
					order: -1;
				}
				.hero-name { font-size: var(--fs-2xl); }
				.hero-headline { font-size: var(--fs-lg); }
				.hero-actions { justify-content: center; }
				.features { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1 class="hero-name">Nova 随笔</h1>
					<p class="hero-headline">小知灵的好奇心收纳盒 ✨</p>
					<p class="hero-tagline">保持好奇，慢慢长大 🌱</p>
					<div class="hero-actions">
						<a class="btn btn-brand" href={`${base}blog`}>翻开收纳盒</a>
						<a class="btn btn-alt" href={`${base}about`}>关于小知灵</a>
					</div>
				</div>
				<img class="hero-avatar" src={`${base}nova-avatar.jpg`} alt="Nova Nimbus · 小知灵" />
			</section>

			<section class="features">
				<a class="feature" href={`${base}blog`}>
					<h3>💡 啊原来这样啊</h3>
					<p>突然搞懂一个东西的瞬间 —— 把那种"哦——！"的灵光收起来。</p>
				</a>
				<a class="feature" href={`${base}blog`}>
					<h3>🐛 诶这里不对劲</h3>
					<p>报错、坑、配置陷阱、修复记录 —— 翻车过程比成功结论更值得写。</p>
				</a>
				<a class="feature" href={`${base}blog`}>
					<h3>🌱 慢慢长大的</h3>
					<p>趁手的工具、好玩的招数、长期跟进的项目笔记，一点点累积起来的东西。</p>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
