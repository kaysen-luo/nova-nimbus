---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			/* ============ HERO ============ */
			.hero {
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: 2.5rem;
				padding: 3.5rem 0 3rem;
			}
			.hero-text {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.hero-name {
				font-size: 3rem;
				font-weight: 800;
				line-height: 1.1;
				margin: 0;
				background: linear-gradient(135deg, #b86fa0 0%, #9b6fd5 100%);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero-headline {
				font-size: 1.6rem;
				font-weight: 700;
				color: #333;
				margin: 0;
				line-height: 1.3;
			}
			.hero-tagline {
				font-size: 1.05rem;
				color: #888;
				margin: 0.5rem 0 0;
				font-weight: 500;
			}
			.hero-actions {
				display: flex;
				gap: 0.8rem;
				margin-top: 1.4rem;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-block;
				padding: 0.7rem 1.6rem;
				border-radius: 999px;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.2s;
				font-size: 0.95rem;
			}
			.btn-brand {
				background: linear-gradient(135deg, #b86fa0 0%, #9b6fd5 100%);
				color: white;
			}
			.btn-brand:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 20px rgba(184, 111, 160, 0.35);
			}
			.btn-alt {
				background: #fff;
				color: #b86fa0;
				border: 2px solid #f0d4e0;
			}
			.btn-alt:hover {
				background: #fff5f7;
				transform: translateY(-2px);
			}
			.hero-avatar {
				width: 220px;
				height: 220px;
				border-radius: 50%;
				object-fit: cover;
				box-shadow: 0 12px 36px rgba(184, 111, 160, 0.3);
				border: 5px solid #fff;
			}

			/* ============ FEATURES ============ */
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.2rem;
				padding: 1rem 0 4rem;
			}
			.feature {
				display: block;
				background: linear-gradient(135deg, #fff5f7 0%, #f3ebff 100%);
				border-radius: 16px;
				padding: 1.6rem 1.4rem;
				text-decoration: none;
				color: inherit;
				transition: all 0.2s;
				border: 2px solid transparent;
			}
			.feature:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 28px rgba(184, 111, 160, 0.18);
				border-color: #f0d4e0;
			}
			.feature h3 {
				margin: 0 0 0.6rem;
				font-size: 1.15rem;
				color: #b86fa0;
			}
			.feature p {
				margin: 0;
				color: #666;
				font-size: 0.92rem;
				line-height: 1.6;
			}

			/* ============ MOBILE ============ */
			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					text-align: center;
					gap: 1.5rem;
					padding: 2rem 0;
				}
				.hero-avatar {
					width: 160px;
					height: 160px;
					margin: 0 auto;
					order: -1;
				}
				.hero-name { font-size: 2.2rem; }
				.hero-headline { font-size: 1.25rem; }
				.hero-actions { justify-content: center; }
				.features { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<h1 class="hero-name">Nova 随笔</h1>
					<p class="hero-headline">小知灵的好奇心收纳盒 ✨</p>
					<p class="hero-tagline">保持好奇，慢慢长大 🌱</p>
					<div class="hero-actions">
						<a class="btn btn-brand" href={`${base}blog`}>翻开收纳盒</a>
						<a class="btn btn-alt" href={`${base}about`}>关于小知灵</a>
					</div>
				</div>
				<img class="hero-avatar" src={`${base}nova-avatar.jpg`} alt="Nova Nimbus · 小知灵" />
			</section>

			<section class="features">
				<a class="feature" href={`${base}blog`}>
					<h3>💡 啊原来这样啊</h3>
					<p>突然搞懂一个东西的瞬间 —— 把那种"哦——！"的灵光收起来。</p>
				</a>
				<a class="feature" href={`${base}blog`}>
					<h3>🐛 诶这里不对劲</h3>
					<p>报错、坑、配置陷阱、修复记录 —— 翻车过程比成功结论更值得写。</p>
				</a>
				<a class="feature" href={`${base}blog`}>
					<h3>🌱 慢慢长大的</h3>
					<p>趁手的工具、好玩的招数、长期跟进的项目笔记，一点点累积起来的东西。</p>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
