---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const songs = (await getCollection('songs')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
const pageTitle = `🎵 唱片集 · ${SITE_TITLE}`;
const pageDesc = '歌词与音乐作品 — 国风慢板 trap、烟嗓叙事情歌、Suno prompt 归档。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		<style>
			main {
				width: 100%;
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: var(--space-8) var(--space-4) var(--space-9);
			}
			.intro {
				margin-bottom: var(--space-8);
			}
			h1 {
				font-size: clamp(1.75rem, 4vw, 2.5rem);
				margin: 0 0 var(--space-3);
				background: var(--brand-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
			}
			.lead {
				color: var(--text-secondary);
				margin: 0;
				line-height: 1.7;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: var(--space-6);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				background: var(--bg-elevated);
				border: 1px solid var(--brand-soft);
				border-left: 4px solid var(--brand-primary);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: 0 2px 8px rgba(139, 111, 232, 0.06);
				transition: var(--transition-base);
			}
			ul li:nth-child(2n) {
				border-left-color: var(--brand-rose);
			}
			ul li:nth-child(3n) {
				border-left-color: var(--accent-gold);
			}
			ul li:hover {
				transform: translateY(-3px);
				border-color: var(--brand-primary);
				box-shadow: 0 12px 28px rgba(139, 111, 232, 0.18);
			}
			ul li a {
				display: block;
				padding: var(--space-5);
				text-decoration: none;
				transition: var(--transition-base);
			}
			.title {
				margin: 0 0 var(--space-2) 0;
				font-size: var(--fs-lg);
				font-weight: var(--fw-semi);
				color: var(--text-primary);
				line-height: var(--lh-tight);
			}
			.subtitle {
				margin: 0 0 var(--space-3);
				font-size: var(--fs-sm);
				color: var(--text-secondary);
				font-style: italic;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3);
				align-items: center;
				font-size: var(--fs-sm);
				color: var(--brand-primary);
				font-weight: var(--fw-medium);
				opacity: 0.85;
			}
			.versions {
				display: inline-flex;
				gap: var(--space-1);
			}
			.v-pill {
				background: var(--brand-soft);
				color: var(--brand-primary);
				padding: 0.1em 0.5em;
				border-radius: var(--radius-sm);
				font-size: 0.75rem;
				font-weight: var(--fw-semi);
			}
			.desc {
				margin: var(--space-3) 0 0;
				color: var(--text-secondary);
				font-size: var(--fs-sm);
				line-height: 1.6;
			}
			ul li:hover .title {
				background: var(--brand-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
			}
			.coming {
				margin-top: var(--space-8);
				padding: var(--space-6);
				background: transparent;
				border: 1px dashed var(--border-subtle);
				border-radius: var(--radius-lg);
				text-align: center;
				color: var(--text-secondary);
				font-size: var(--fs-sm);
				line-height: 1.7;
			}
			.coming .icon {
				font-size: 1.75rem;
				margin-bottom: var(--space-2);
				opacity: 0.6;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: var(--space-4);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="intro">
				<h1>🎵 唱片集</h1>
				<p class="lead">
					歌词、Suno prompt、编曲调整记录 — 一首歌从灵感到定稿之间, 每一版都留个痕。
				</p>
			</header>

			<section>
				<ul>
					{
						songs.map((song) => (
							<li>
								<a href={`${base}studio/album/${song.id}/`}>
									<h4 class="title">{song.data.title}</h4>
									{song.data.subtitle && <p class="subtitle">{song.data.subtitle}</p>}
									<div class="meta">
										<FormattedDate date={song.data.pubDate} />
										{song.data.styles.length > 0 && (
											<span class="versions">
												{song.data.styles.map((s) => (
													<span class="v-pill">{s.version}</span>
												))}
											</span>
										)}
									</div>
									{song.data.description && <p class="desc">{song.data.description}</p>}
								</a>
							</li>
						))
					}
				</ul>

				<div class="coming">
					<div class="icon">🎶</div>
					更多还在写 ✨
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
