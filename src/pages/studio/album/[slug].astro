---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const songs = await getCollection('songs');
	return songs.map((song) => ({
		params: { slug: song.id },
		props: song,
	}));
}

type Props = CollectionEntry<'songs'>;
const song = Astro.props;
const { Content } = await render(song);
const { title, subtitle, pubDate, updatedDate, description, styles, platform, status, lyrics } = song.data;

const platformLabel: Record<string, string> = {
	suno: 'Suno',
	tianyin: '网易天音',
	heartmula: 'HeartMuLa',
	other: '其他',
};
const statusLabel: Record<string, string> = {
	draft: '草稿',
	generated: '已跑音频',
	shipped: '定稿',
};
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · 唱片集`} description={description || subtitle || title} />
		<style>
			main {
				width: 100%;
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: var(--space-8) var(--space-4) var(--space-9);
				color: var(--text-primary);
			}
			.crumb {
				font-size: var(--fs-sm);
				color: var(--text-secondary);
				margin-bottom: var(--space-5);
			}
			.crumb a {
				color: var(--brand-primary);
				text-decoration: none;
			}
			.crumb a:hover { text-decoration: underline; }

			.song-header { margin-bottom: var(--space-7); }
			h1 {
				font-size: clamp(2rem, 5vw, 2.75rem);
				margin: 0 0 var(--space-2);
				background: var(--brand-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
				line-height: 1.2;
			}
			.subtitle {
				color: var(--text-secondary);
				font-size: var(--fs-md);
				margin: 0 0 var(--space-3);
				font-style: italic;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3);
				align-items: center;
				font-size: var(--fs-sm);
				color: var(--text-secondary);
			}
			.tag {
				background: var(--brand-soft);
				color: var(--brand-primary);
				padding: 0.15em 0.6em;
				border-radius: var(--radius-sm);
				font-weight: var(--fw-medium);
				font-size: 0.8rem;
			}
			.tag.status {
				background: rgba(240, 200, 120, 0.18);
				color: var(--accent-gold);
			}

			h2 {
				font-size: var(--fs-xl);
				margin: var(--space-8) 0 var(--space-4);
				color: var(--text-primary);
				display: flex;
				align-items: center;
				gap: var(--space-2);
			}
			h2::before {
				content: '';
				display: inline-block;
				width: 3px;
				height: 1em;
				background: var(--brand-gradient);
				border-radius: 2px;
			}

			.styles-grid {
				display: grid;
				gap: var(--space-5);
			}
			.style-card {
				background: var(--bg-elevated);
				border: 1px solid var(--brand-soft);
				border-left: 4px solid var(--brand-primary);
				border-radius: var(--radius-lg);
				padding: var(--space-5);
			}
			.style-card:nth-child(2n) { border-left-color: var(--brand-rose); }
			.style-card:nth-child(3n) { border-left-color: var(--accent-gold); }

			.style-head {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3);
				align-items: baseline;
				margin-bottom: var(--space-3);
			}
			.style-version {
				font-size: var(--fs-lg);
				font-weight: var(--fw-semi);
				color: var(--brand-primary);
			}
			.style-label {
				color: var(--text-secondary);
				font-size: var(--fs-sm);
			}
			.style-date {
				color: var(--text-secondary);
				font-size: var(--fs-sm);
				opacity: 0.8;
				margin-left: auto;
			}

			.prompt-block, .lyrics-block {
				background: var(--bg-base);
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-md);
				padding: var(--space-4);
				font-family: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.7;
				white-space: pre-wrap;
				word-wrap: break-word;
				overflow-x: auto;
				color: var(--text-primary);
			}
			.lyrics-block {
				font-family: var(--font-serif, Georgia, 'STZhongsong', serif);
				font-size: 0.95rem;
				line-height: 2;
				background: linear-gradient(180deg, var(--bg-elevated), var(--bg-base));
			}

			.style-field-label {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-secondary);
				margin: var(--space-3) 0 var(--space-2);
				font-weight: var(--fw-semi);
				display: flex;
				justify-content: space-between;
				align-items: baseline;
			}
			.char-count {
				font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
				font-size: 0.7rem;
				color: var(--text-secondary);
				text-transform: none;
				letter-spacing: 0;
				opacity: 0.7;
			}
			.char-count.over { color: var(--brand-rose); opacity: 1; }

			.exclude-block {
				background: rgba(255, 142, 209, 0.06);
				border: 1px solid rgba(255, 142, 209, 0.2);
				color: var(--text-secondary);
				padding: var(--space-3) var(--space-4);
				border-radius: var(--radius-md);
				font-size: 0.8rem;
				line-height: 1.6;
				font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
			}

			/* MDX 内容区: 创作背景 / 编曲调整 / 歌词等正文段落 */
			.prose {
				line-height: 1.8;
				color: var(--text-primary);
			}
			.prose h2 { /* MDX 里如果用 ## 会进这里 */ }
			.prose p { margin: 0 0 var(--space-3); }
			.prose pre {
				background: linear-gradient(180deg, var(--bg-elevated), var(--bg-base));
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-md);
				padding: var(--space-5);
				overflow-x: auto;
				font-family: var(--font-serif, Georgia, 'STZhongsong', serif);
				font-size: 0.95rem;
				line-height: 2;
				white-space: pre-wrap;
			}
			.prose code {
				font-family: var(--font-serif, Georgia, 'STZhongsong', serif);
				color: var(--text-primary);
				background: none;
				padding: 0;
			}
			.prose strong { color: var(--brand-primary); }
			.prose ul li { margin-bottom: var(--space-2); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="crumb">
				<a href="/studio/">创意灵域</a> · <a href="/studio/album/">唱片集</a>
			</nav>

			<header class="song-header">
				<h1>{title}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}
				<div class="meta">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span>· 最近调整 <FormattedDate date={updatedDate} /></span>
					)}
					<span class="tag">{platformLabel[platform] || platform}</span>
					<span class="tag status">{statusLabel[status] || status}</span>
				</div>
			</header>

			{lyrics && (
				<section>
					<h2>歌词</h2>
					<div class="lyrics-block">{lyrics}</div>
				</section>
			)}

			{styles.length > 0 && (
				<section>
					<h2>Suno Style 字段 · {styles.length} 版编曲</h2>
					<div class="styles-grid">
						{styles.map((s) => (
							<article class="style-card">
								<div class="style-head">
									<span class="style-version">{s.version}</span>
									{s.label && <span class="style-label">{s.label}</span>}
									{s.date && (
										<span class="style-date">
											<FormattedDate date={s.date} />
										</span>
									)}
								</div>

								<div class="style-field-label">
									<span>Style</span>
									{s.charCount != null && (
										<span class={`char-count ${s.charCount > 1000 ? 'over' : ''}`}>
											{s.charCount} / 1000
										</span>
									)}
								</div>
								<div class="prompt-block">{s.prompt}</div>

								{s.excludeStyles && (
									<>
										<div class="style-field-label">Exclude Styles</div>
										<div class="exclude-block">{s.excludeStyles}</div>
									</>
								)}
							</article>
						))}
					</div>
				</section>
			)}

			<section class="prose">
				<Content />
			</section>
		</main>
		<Footer />
	</body>
</html>
