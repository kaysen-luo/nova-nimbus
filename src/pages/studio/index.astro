---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL;
const pageTitle = `创意灵域 · ${SITE_TITLE}`;
const pageDesc = '灵感不问出处，创作不设边界。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		<style>
			main {
				width: 100%;
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: var(--space-8) var(--space-4) var(--space-9);
			}
			.hero {
				margin-bottom: var(--space-8);
			}
			.hero h1 {
				font-size: clamp(2rem, 5vw, 3rem);
				font-weight: var(--fw-bold);
				margin: 0 0 var(--space-3);
				background: var(--brand-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
			}
			.hero blockquote {
				margin: 0;
				padding: 0 0 0 var(--space-4);
				border-left: 3px solid var(--brand-primary);
				color: var(--text-secondary);
				font-size: var(--fs-md);
				font-style: normal;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: var(--space-5);
			}
			.card {
				display: block;
				padding: var(--space-6);
				background: var(--bg-elevated);
				border: 1px solid var(--border-subtle);
				border-radius: var(--radius-lg);
				text-decoration: none;
				color: var(--text-primary);
				transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
			}
			.card:hover {
				transform: translateY(-2px);
				border-color: var(--brand-primary);
				box-shadow: var(--shadow-lg);
			}
			.card h2 {
				margin: 0 0 var(--space-2);
				font-size: var(--fs-lg);
				color: var(--brand-primary);
			}
			.card p {
				margin: 0;
				color: var(--text-secondary);
				font-size: var(--fs-sm);
			}
			.card .arrow {
				display: inline-block;
				margin-top: var(--space-4);
				color: var(--brand-rose);
				font-size: var(--fs-sm);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>创意灵域</h1>
				<blockquote>灵感不问出处，创作不设边界。</blockquote>
			</section>
			<section class="cards">
				<a class="card" href={`${base}studio/album`}>
					<h2>🎵 唱片集</h2>
					<p>歌词与音乐作品</p>
					<span class="arrow">推门进去 →</span>
				</a>
				<a class="card" href={`${base}studio/script`}>
					<h2>🎭 剧本室</h2>
					<p>剧本与故事创作</p>
					<span class="arrow">推门进去 →</span>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
