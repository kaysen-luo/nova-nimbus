---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// 用 decodeURIComponent 规范化, 兼容浏览器可能对中文 URL 的百分号编码
const decode = (s: string) => {
	try { return decodeURIComponent(s); } catch { return s; }
};
const pathname = decode(Astro.url.pathname).replace(import.meta.env.BASE_URL, '');
const normalizedPath = '/' + pathname.replace(/^\/+|\/+$/g, '');
const normalizedHref = '/' + decode(String(href ?? '')).replace(/^\/+|\/+$/g, '');

const isActive =
	normalizedPath === normalizedHref ||
	(normalizedHref !== '/' && normalizedPath.startsWith(normalizedHref + '/'));
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
